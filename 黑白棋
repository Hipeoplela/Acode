<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>✨ 精緻黑白棋 Reversi ✨</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#6366f1',
                        secondary: '#8b5cf6',
                        accent: '#06b6d4',
                        success: '#10b981',
                        warning: '#f59e0b',
                        danger: '#ef4444'
                    },
                    animation: {
                        'float': 'float 6s ease-in-out infinite',
                        'glow': 'glow 2s ease-in-out infinite alternate',
                        'bounce-gentle': 'bounce-gentle 2s ease-in-out infinite',
                        'sparkle': 'sparkle 1.5s ease-in-out infinite',
                        'victory-dance': 'victory-dance 0.8s ease-in-out',
                        'slide-up': 'slide-up 0.5s ease-out',
                        'zoom-in': 'zoom-in 0.3s ease-out',
                        'confetti': 'confetti 3s ease-out forwards'
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;600;700;800&display=swap');
        
        body {
            font-family: 'Nunito', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
        }

        .dark body {
            background: linear-gradient(135deg, #2d1b69 0%, #11998e 100%);
        }

        /* 浮動動畫背景 */
        .bg-animated {
            background: linear-gradient(-45deg, #667eea, #764ba2, #8b5cf6, #06b6d4);
            background-size: 400% 400%;
            animation: gradient 15s ease infinite;
        }

        .dark .bg-animated {
            background: linear-gradient(-45deg, #2d1b69, #11998e, #4c1d95, #0e7490);
            background-size: 400% 400%;
        }

        @keyframes gradient {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
        }

        @keyframes glow {
            from { box-shadow: 0 0 20px rgba(99, 102, 241, 0.5); }
            to { box-shadow: 0 0 30px rgba(99, 102, 241, 0.8), 0 0 40px rgba(99, 102, 241, 0.3); }
        }

        @keyframes bounce-gentle {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-5px); }
        }

        @keyframes sparkle {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.7; transform: scale(1.1); }
        }

        @keyframes victory-dance {
            0%, 100% { transform: scale(1) rotate(0deg); }
            25% { transform: scale(1.1) rotate(-5deg); }
            50% { transform: scale(1.2) rotate(0deg); }
            75% { transform: scale(1.1) rotate(5deg); }
        }

        @keyframes slide-up {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes zoom-in {
            from { opacity: 0; transform: scale(0.8); }
            to { opacity: 1; transform: scale(1); }
        }

        @keyframes confetti {
            0% { transform: translateY(0) rotateZ(0deg); opacity: 1; }
            100% { transform: translateY(-100vh) rotateZ(720deg); opacity: 0; }
        }

        /* 玻璃質感效果 */
        .glass {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .dark .glass {
            background: rgba(0, 0, 0, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        /* 棋盤樣式 */
        .board-container {
            background: linear-gradient(145deg, #2d5016, #4a7c1a);
            box-shadow: 
                0 20px 40px rgba(0, 0, 0, 0.3),
                inset 0 1px 0 rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 16px;
        }

        .cell {
            background: linear-gradient(145deg, #367a1f, #2d5016);
            border: 2px solid #1a3d0d;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

        .cell:hover {
            background: linear-gradient(145deg, #4a8c26, #367a1f);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
        }

        .cell::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s;
        }

        .cell:hover::before {
            left: 100%;
        }

        /* 棋子樣式 */
        .piece {
            transition: all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            transform-style: preserve-3d;
            position: relative;
        }

        .piece-black {
            background: linear-gradient(145deg, #1f2937, #374151);
            box-shadow: 
                0 8px 16px rgba(0, 0, 0, 0.4),
                inset 0 1px 0 rgba(255, 255, 255, 0.1),
                inset 0 -1px 0 rgba(0, 0, 0, 0.2);
        }

        .piece-white {
            background: linear-gradient(145deg, #ffffff, #f3f4f6);
            box-shadow: 
                0 8px 16px rgba(0, 0, 0, 0.2),
                inset 0 1px 0 rgba(255, 255, 255, 0.3),
                inset 0 -1px 0 rgba(0, 0, 0, 0.1);
        }

        /* 動畫效果 */
        .piece.placing {
            animation: placeAnimation 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        }

        @keyframes placeAnimation {
            0% { 
                transform: scale(0) rotateY(180deg);
                opacity: 0;
            }
            70% { 
                transform: scale(1.3) rotateY(0deg);
                opacity: 1;
            }
            100% { 
                transform: scale(1) rotateY(0deg);
                opacity: 1;
            }
        }

        .piece.flipping {
            animation: flipAnimation 0.8s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        }

        @keyframes flipAnimation {
            0% { transform: rotateY(0deg) scale(1); }
            25% { transform: rotateY(45deg) scale(1.1); }
            50% { transform: rotateY(90deg) scale(1.2); }
            75% { transform: rotateY(135deg) scale(1.1); }
            100% { transform: rotateY(180deg) scale(1); }
        }

        /* 有效移動提示 */
        .valid-move {
            position: relative;
        }

        .valid-move::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 14px;
            height: 14px;
            background: radial-gradient(circle, #fbbf24, #f59e0b);
            border: 2px solid #ffffff;
            border-radius: 50%;
            transform: translate(-50%, -50%);
            animation: validMovePulse 2s ease-in-out infinite;
            box-shadow: 0 0 15px rgba(251, 191, 36, 0.6);
        }

        @keyframes validMovePulse {
            0%, 100% { 
                opacity: 0.8; 
                transform: translate(-50%, -50%) scale(1);
                box-shadow: 0 0 15px rgba(251, 191, 36, 0.6);
            }
            50% { 
                opacity: 1; 
                transform: translate(-50%, -50%) scale(1.4);
                box-shadow: 0 0 25px rgba(251, 191, 36, 0.8);
            }
        }

        /* 按鈕樣式 */
        .btn-primary {
            background: linear-gradient(145deg, #6366f1, #4f46e5);
            box-shadow: 0 10px 20px rgba(99, 102, 241, 0.3);
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            background: linear-gradient(145deg, #4f46e5, #4338ca);
            box-shadow: 0 15px 30px rgba(99, 102, 241, 0.4);
            transform: translateY(-2px);
        }

        .btn-secondary {
            background: linear-gradient(145deg, #6b7280, #4b5563);
            box-shadow: 0 10px 20px rgba(107, 114, 128, 0.3);
        }

        .btn-secondary:hover {
            background: linear-gradient(145deg, #4b5563, #374151);
            transform: translateY(-2px);
        }

        /* 計分器動畫 */
        .score-change {
            animation: scoreChange 0.8s ease-out;
        }

        @keyframes scoreChange {
            0% { transform: scale(1); }
            50% { transform: scale(1.3); color: #10b981; }
            100% { transform: scale(1); }
        }

        /* 粒子效果 */
        .particle {
            position: absolute;
            width: 4px;
            height: 4px;
            background: #fbbf24;
            border-radius: 50%;
            pointer-events: none;
            animation: particle 2s ease-out forwards;
        }

        @keyframes particle {
            0% {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
            100% {
                opacity: 0;
                transform: translateY(-50px) scale(0);
            }
        }

        /* 勝利慶祝效果 */
        .victory-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 50;
        }

        .confetti-piece {
            position: absolute;
            width: 8px;
            height: 8px;
            animation: confetti 3s ease-out forwards;
        }

        /* 載入動畫 */
        .loading-dots {
            display: inline-flex;
            gap: 4px;
        }

        .loading-dots span {
            width: 8px;
            height: 8px;
            background: currentColor;
            border-radius: 50%;
            animation: loading 1.4s ease-in-out infinite both;
        }

        .loading-dots span:nth-child(1) { animation-delay: -0.32s; }
        .loading-dots span:nth-child(2) { animation-delay: -0.16s; }

        @keyframes loading {
            0%, 80%, 100% { transform: scale(0); }
            40% { transform: scale(1); }
        }

        /* 響應式改進 */
        @media (max-width: 640px) {
            .cell {
                border-width: 1px;
            }
            
            .valid-move::after {
                width: 10px;
                height: 10px;
            }
        }
    </style>
</head>
<body class="bg-animated min-h-screen">
